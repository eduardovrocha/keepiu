# Keepiu Environment Variables
# Copy this file to .env and fill in your real values
# NEVER commit .env with real credentials

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=signalvault-webhook-secret

# JWT Secret (use a long random string in production)
JWT_SECRET=signalvault-jwt-secret-change-in-production

# Username to auto-promote to admin on startup
INITIAL_ADMIN_USERNAME=your_username_here

FRONTEND_URL=http://localhost:5173

# Environment
ENVIRONMENT=development

# Sentry (optional — get DSN from sentry.io)
SENTRY_DSN=

# Telegram bot public link (for Settings page)
VITE_TELEGRAM_BOT_LINK=https://t.me/YourBotName

# WhatsApp Business Platform (Meta)
# Create your app at https://developers.facebook.com → Add product "WhatsApp"
# These can be left empty here — configure them via the Settings UI instead.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Settings encryption key (encrypt secrets stored in DB via UI)
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

# App mode — "single_user" (personal vault, one password) | "multi_user" (SaaS)
APP_MODE=multi_user

# Required when APP_MODE=single_user
# APP_PASSWORD=your-strong-password-here
# Generate SESSION_SECRET: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Processing mode — "worker" (Celery + Redis) | "inline" (no Redis needed, single instance)
PROCESSING_MODE=worker

# Flower monitoring auth (user:password)
FLOWER_BASIC_AUTH=admin:changeme

# Production database (used by docker-compose.prod.yml)
POSTGRES_USER=signalvault
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=signalvault

# Frontend URL (baked into the React build at image-build time)
VITE_API_URL=https://yourdomain.com
